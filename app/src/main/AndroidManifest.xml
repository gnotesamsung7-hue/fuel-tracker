<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No CAMERA permission needed: the receipt scanner launches the system
         camera app via an implicit intent (ACTION_IMAGE_CAPTURE) rather than
         embedding a live camera preview, so this app never touches the
         camera hardware directly. See ScanReceiptScreen.kt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Nearby fuel stations: a coarse fix is enough, but fine location is
         requested too since it's what most devices actually have enabled.
         INTERNET is only used for the keyless OpenStreetMap Overpass API call
         this feature makes. Everything else in the app is fully offline. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Car Bluetooth check-in prompt: when the phone connects to the car's
         Bluetooth (engine on), FillUp+ posts a "check in" notification.
         BLUETOOTH_CONNECT (Android 12+) is asked for only when the user picks
         their car in Car settings; nothing is scanned or paired by the app. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.FuelTracker"
        android:supportsRtl="true"
        android:name=".FuelTrackerApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FuelTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ACL_CONNECTED is exempt from the background implicit-broadcast
             limits, so this still fires with the app closed. -->
        <receiver
            android:name=".bluetooth.CarBluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
